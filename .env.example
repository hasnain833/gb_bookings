# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# Authentication (use a unique random value of at least 32 characters outside local development)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Brevo transactional email. The sender address must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=GBBookings

# Cloudinary signed server-side uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_FILE_MB=10

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/gbbookings
MONGODB_DB_NAME=gbbookings

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional until the AI planner is enabled.
GEMINI_API_KEY=
