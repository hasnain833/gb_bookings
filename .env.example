# Application
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:3000

# Public support contacts shown in the site footer (baked into the frontend build). Leave empty to hide.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_WHATSAPP=
TRUST_PROXY=false

# Authentication (use a unique random value of at least 32 characters outside local development)
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
REMEMBER_ME_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Resend API. Use an API key with sending access and an address on a verified domain.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=GBBookings

# Cloudinary signed server-side uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MEDIA_MAX_FILE_MB=10

# Database. Atlas is supported; local MongoDB must run as a replica set for booking transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/gbbookings?replicaSet=rs0
MONGODB_DB_NAME=gbbookings

# Optional until the AI planner is enabled.
GEMINI_API_KEY=
